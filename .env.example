# Template for mirofish/.env, which `python -m ops bootstrap` creates (git-ignored, owner-only).
# Never put a real key in this file, in mirofish/.env or in any tracked file.
#
# What `python -m ops start` manages on every start:
#   LLM_BASE_URL    the local relay (http://127.0.0.1:<relay port>/v1). The relay holds your Gemini
#                   key, meters spend, enforces the kill switch and forwards to Gemini.
#   LLM_API_KEY     a random per-session token for the relay. It is not your Gemini key.
#   LLM_MODEL_NAME  informational; the relay sets the model per stage from ops/config/llm.yaml.
# ZEP_API_KEY is NOT stored here. `start` reads it from the ZEP_API_KEY environment variable or
# the OS keychain and passes it to MiroFish in the process environment only. Upstream loads this
# file with override=True, so a ZEP_API_KEY line here would win; `start` refuses to run if one exists.

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=

# Never set LLM_BOOST_* (it would send the Reddit simulation around the relay) or ZEP_API_URL.

# ----- Backend server: loopback only -----
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=False
# bootstrap replaces this with a random value
SECRET_KEY=change-me

# ----- Browser-facing hardening (ops/patches/0001-server-hardening.patch) -----
# Only the local frontend may read API responses; requests with any other Host header are refused
# (blocks DNS rebinding, so a web page cannot spend on your keys); request bodies are not logged.
MIROFISH_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
MIROFISH_ALLOWED_HOSTS=127.0.0.1:5001,localhost:5001
MIROFISH_LOG_REQUEST_BODIES=false

# ----- Telemetry off; one-time downloads cached by bootstrap, then offline -----
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
DO_NOT_TRACK=1
ANONYMIZED_TELEMETRY=False
LANGFUSE_ENABLED=False
TRACEROOT_ENABLED=False
# Never set: LANGCHAIN_TRACING_V2, LANGSMITH_API_KEY, AGENTOPS_API_KEY
