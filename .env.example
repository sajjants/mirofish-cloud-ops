# Template for the git-ignored .env that bootstrap generates for MiroFish (mirofish/.env).
# Do NOT put real keys in this file or in any tracked file. Keys are read from environment
# variables or the OS keychain (python -m ops keys set ...) and written only to the generated,
# permission-restricted mirofish/.env.

# ----- LLM (Google Gemini via its OpenAI-compatible endpoint) -----
# Base URL and model names are placeholders until verified against Google's current docs (Phase 2).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=

# Optional second model. Upstream reads these only if all three are set; which stages use it
# is documented in ops/CLOUD_PLAN.md (Phase 1). Leave unset to use one model everywhere.
# LLM_BOOST_API_KEY=
# LLM_BOOST_BASE_URL=
# LLM_BOOST_MODEL_NAME=

# ----- Memory (Zep Cloud, upstream's native memory service) -----
ZEP_API_KEY=

# ----- Backend server: loopback only -----
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=False
